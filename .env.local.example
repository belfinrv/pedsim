# Copy this file to `.env.local` to enable the LLM engine when running
# `pnpm dev` / `pnpm start`. Without it, PedSim runs on the deterministic rule
# engine (no key required). `.env.local` is git-ignored, so your key stays local.
#
# (For the Cloudflare `pnpm preview` / `pnpm run deploy` path, use `.dev.vars`
#  and `wrangler secret put` instead — see README.md.)

# Your Anthropic API key — enables Claude-generated child/parent dialogue and
# LLM rubric grading. Rapport math and fact-tracking stay deterministic either way.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional model override (defaults to claude-sonnet-5).
PEDSIM_MODEL=claude-sonnet-5
